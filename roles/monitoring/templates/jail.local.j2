# {{ ansible_managed }}

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 3

# Never ban localhost. Bans are applied as UFW rules.
ignoreip = 127.0.0.1/8 ::1
banaction = ufw

[sshd]
enabled = true
port    = ssh
# Distro-provided defaults, so the jail works whether sshd logs to a file or the journal.
logpath = %(sshd_log)s
backend = %(sshd_backend)s
