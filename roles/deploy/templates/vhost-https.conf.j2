# {{ ansible_managed }}

# HTTPS requests for any other name, or for the bare IP, are refused during the
# TLS handshake instead of being answered with this site.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ ([domain] + domain_aliases) | join(' ') }};

    root {{ web_root }};
    index index.html;

    ssl_certificate /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # "always" so the headers are also sent on error responses such as 404.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Everything is self-hosted. Inline style attributes are allowed because
    # markdown-it writes table column alignment as style="text-align: ...".
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;

    server_tokens off;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\.(git|env) {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# Redirect HTTP to HTTPS for the site's own names only; anything else gets a 404.
server {
    listen 80;
    listen [::]:80;
    server_name {{ ([domain] + domain_aliases) | join(' ') }};

    server_tokens off;

{% for name in [domain] + domain_aliases %}
    if ($host = {{ name }}) {
        return 301 https://$host$request_uri;
    }
{% endfor %}

    return 404;
}
