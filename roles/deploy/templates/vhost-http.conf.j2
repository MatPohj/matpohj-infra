# {{ ansible_managed }}
# Bootstrap vhost: HTTP only, used until the Let's Encrypt certificate exists.
# After certbot has run, the deploy role pushes the HTTPS vhost instead.
server {
    listen 80;
    listen [::]:80;
    server_name {{ ([domain] + domain_aliases) | join(' ') }};

    root {{ web_root }};
    index index.html;

    server_tokens off;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\.(git|env) {
        deny all;
        access_log off;
        log_not_found off;
    }
}
